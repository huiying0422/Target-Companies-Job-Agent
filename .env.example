# Copy to .env and fill in real values. Never commit .env (it is gitignored).

# Optional — used in ranker.py verdict prompts (defaults to "the candidate")
CANDIDATE_NAME=Your Name

# Claude API — resume tailoring (Page 2) and job verdict ranking (main.py)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Gmail SMTP — job match notification emails (main.py / notifier.py)
GMAIL_FROM=your.name@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
NOTIFY_EMAIL=your.name@gmail.com
